<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'VulnShop' %></title>
<link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg">
<style>
  :root{
    --bg:#f3f5f9;--surface:#fff;--surface2:#f8fafc;--border:#e6e9ef;--ink:#141b2d;--muted:#6b7280;
    --brand:#2f6fed;--brand-dark:#1f52c0;--accent:#0f9d6a;--accent-dark:#0b7a52;
    --danger:#d64545;--danger-bg:#fdecec;--warn:#b4690e;--warn-bg:#fdf3e3;--star:#f5a623;
    --shadow:0 1px 2px rgba(16,24,40,.06);--shadow-lg:0 10px 30px -12px rgba(16,24,40,.25);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}
  a{color:var(--brand);text-decoration:none}
  a:hover{text-decoration:underline}
  img{display:block;max-width:100%}
  .wrap{max-width:1120px;margin:0 auto;padding:0 20px}

  /* Promo strip */
  .promo{background:linear-gradient(90deg,var(--brand),var(--accent));color:#fff;font-size:13px;text-align:center;padding:7px 12px;font-weight:500;letter-spacing:.2px}

  /* Topbar */
  .topbar{background:var(--surface);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:20;box-shadow:var(--shadow)}
  .topbar .wrap{display:flex;align-items:center;gap:18px;height:66px}
  .logo{font-weight:800;font-size:21px;display:flex;align-items:center;gap:10px;color:var(--ink);white-space:nowrap}
  .logo:hover{text-decoration:none}
  .logo img{width:34px;height:34px}
  .logo b{background:linear-gradient(90deg,var(--brand),var(--accent));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .search{flex:1;max-width:440px;display:flex}
  .search input{flex:1;border:1px solid var(--border);border-right:none;border-radius:999px 0 0 999px;padding:10px 18px;font-size:14px;background:var(--surface2);outline:none}
  .search input:focus{border-color:var(--brand);background:#fff}
  .search button{border:none;border-radius:0 999px 999px 0;background:var(--brand);color:#fff;padding:0 18px;cursor:pointer;font-size:15px}
  .search button:hover{background:var(--brand-dark)}
  .nav{margin-left:auto;display:flex;align-items:center;gap:16px;font-size:14px}
  .nav a{color:var(--ink);font-weight:500;display:flex;align-items:center;gap:6px}
  .nav a:hover{color:var(--brand);text-decoration:none}
  .modeflag{font-size:11px;font-weight:700;padding:4px 11px;border-radius:999px;letter-spacing:.3px}
  .mode-vuln{background:var(--danger-bg);color:var(--danger)}
  .mode-sec{background:#e3f6ee;color:var(--accent-dark)}

  /* Category bar */
  .catbar{background:var(--surface);border-bottom:1px solid var(--border)}
  .catbar .wrap{display:flex;gap:6px;height:46px;align-items:center;overflow-x:auto}
  .catbar a{font-size:13.5px;color:var(--muted);padding:6px 14px;border-radius:999px;font-weight:500;white-space:nowrap}
  .catbar a:hover{background:var(--surface2);color:var(--ink);text-decoration:none}
  .catbar a.on{background:var(--brand);color:#fff}

  main{padding:26px 0 56px}
  h1{font-size:25px;margin:0 0 6px;letter-spacing:-.3px}
  h2{font-size:18px;letter-spacing:-.2px}
  .muted{color:var(--muted)}
  .card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px;box-shadow:var(--shadow)}

  /* Hero */
  .hero{position:relative;overflow:hidden;border-radius:18px;background:linear-gradient(120deg,#16275a,#1f52c0 55%,#1f8f6b);color:#fff;padding:40px 44px;margin-bottom:26px;box-shadow:var(--shadow-lg)}
  .hero h2{font-size:32px;margin:0 0 10px;font-weight:800;letter-spacing:-.5px;max-width:560px;color:#fff}
  .hero p{margin:0 0 20px;font-size:16px;color:#dbe6ff;max-width:520px}
  .hero .btn{background:#fff;color:var(--brand-dark);font-weight:700}
  .hero .btn:hover{background:#eef3ff}
  .hero .deco{position:absolute;right:-30px;top:-20px;width:340px;height:340px;opacity:.25;pointer-events:none}
  .hero .deco2{position:absolute;right:150px;bottom:-130px;width:230px;height:230px;border-radius:50%;background:rgba(255,255,255,.10)}

  /* Product grid */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(236px,1fr));gap:20px}
  .prod{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;box-shadow:var(--shadow);transition:transform .14s ease,box-shadow .14s ease;position:relative}
  .prod:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .prod a.coverlink{position:absolute;inset:0;z-index:1}
  .prod .thumb{aspect-ratio:1/1;background:var(--surface2)}
  .prod .thumb img{width:100%;height:100%;object-fit:cover}
  .prod .pinfo{padding:14px 16px 16px}
  .prod .cat{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;font-weight:600}
  .prod .pname{font-weight:650;font-size:15px;margin:3px 0 7px;min-height:40px}
  .prod .rating{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--muted);margin-bottom:10px}
  .prod .foot{display:flex;justify-content:space-between;align-items:center}
  .badge{position:absolute;top:12px;left:12px;z-index:2;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;color:#fff;background:var(--danger)}
  .badge.free{background:var(--accent);left:auto;right:12px}

  .stars{color:var(--star);letter-spacing:1px;font-size:13px}
  .stars .off{color:#d9dee7}
  .price{font-weight:800;font-size:17px}
  .price .old{font-weight:500;font-size:13px;color:var(--muted);text-decoration:line-through;margin-right:6px}

  /* Buttons */
  .btn{border:none;border-radius:10px;padding:10px 16px;font-size:14px;font-weight:650;cursor:pointer;background:var(--brand);color:#fff;display:inline-block;position:relative;z-index:2;transition:background .14s}
  .btn:hover{background:var(--brand-dark);text-decoration:none}
  .btn.accent{background:var(--accent)}.btn.accent:hover{background:var(--accent-dark)}
  .btn.ghost{background:#fff;color:var(--brand);border:1px solid var(--border)}.btn.ghost:hover{background:var(--surface2)}
  .btn.sm{padding:8px 13px;font-size:13px}
  .btn.icon{width:40px;height:40px;padding:0;display:grid;place-items:center;font-size:17px}

  .field{margin-bottom:14px}
  .field label{display:block;font-size:13px;font-weight:600;margin-bottom:6px}
  .field input,.field textarea,.field select{width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:10px;background:var(--surface2);font-size:14px;font-family:inherit;outline:none}
  .field input:focus,.field textarea:focus{border-color:var(--brand);background:#fff}

  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--border)}
  th{font-size:12px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted)}
  .pill{display:inline-block;padding:4px 11px;border-radius:999px;font-size:12px;font-weight:600;background:#e8f0ff;color:var(--brand-dark)}

  .breadcrumb{font-size:13px;color:var(--muted);margin-bottom:14px}
  .breadcrumb a{color:var(--muted)}

  /* Review */
  .review{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--border)}
  .avatar{width:38px;height:38px;border-radius:50%;flex:none;display:grid;place-items:center;color:#fff;font-weight:700;font-size:15px;background:linear-gradient(135deg,var(--brand),var(--accent))}

  /* Security note (TPI) */
  .vuln{margin-top:22px;border:1px solid var(--danger);border-left-width:4px;background:var(--danger-bg);border-radius:10px;padding:14px 16px;font-size:13px}
  .vuln.safe{border-color:var(--accent);background:#e9f7f1}
  .vuln summary{cursor:pointer;font-weight:700;list-style:none;display:flex;align-items:center;gap:8px}
  .vuln summary::-webkit-details-marker{display:none}
  .vuln[open] summary{margin-bottom:8px}
  .vuln code,pre code{font-family:ui-monospace,Menlo,Consolas,monospace}
  pre{background:#0d1117;color:#e6edf3;padding:12px;border-radius:8px;overflow:auto;font-size:12.5px}
  .error{background:var(--warn-bg);color:var(--warn);border-radius:8px;padding:11px 13px;font-size:13px;margin:12px 0;border:1px solid #f0d9a8}

  /* Footer */
  footer.site{border-top:1px solid var(--border);background:var(--surface);margin-top:30px}
  .fgrid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:28px;padding:36px 0 26px}
  .fgrid h4{font-size:13px;text-transform:uppercase;letter-spacing:.4px;color:var(--ink);margin:0 0 12px}
  .fgrid ul{list-style:none;padding:0;margin:0;font-size:13.5px}
  .fgrid li{margin-bottom:8px}.fgrid a{color:var(--muted)}
  .fbrand{font-size:13.5px;color:var(--muted);max-width:280px}
  .pay{display:flex;gap:7px;margin-top:12px}
  .pay span{font-size:10px;font-weight:700;color:var(--muted);border:1px solid var(--border);border-radius:6px;padding:4px 7px;background:var(--surface2)}
  .fbar{border-top:1px solid var(--border);font-size:12.5px;color:var(--muted);padding:14px 0}
  .fbar .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}

  @media(max-width:720px){
    .search{order:3;max-width:none;flex-basis:100%}
    .topbar .wrap{flex-wrap:wrap;height:auto;padding-top:12px;padding-bottom:12px;gap:12px}
    .fgrid{grid-template-columns:1fr 1fr}
    .hero{padding:30px 24px}.hero h2{font-size:25px}.hero .deco{display:none}
  }
</style>
</head>
<body>
<div class="promo">🚚 Envío gratis en compras superiores a $20.000 &nbsp;·&nbsp; 🔒 Pago protegido &nbsp;·&nbsp; 📦 Cambios sin cargo por 30 días</div>
<header class="topbar"><div class="wrap">
  <a class="logo" href="/"><img src="/static/img/favicon.svg" alt=""> Vuln<b>Shop</b></a>
  <form class="search" action="/" method="get"><input name="q" placeholder="Buscar productos, marcas y más..." value="<%= typeof q !== 'undefined' ? q : '' %>"><button aria-label="Buscar">🔍</button></form>
  <nav class="nav">
    <span class="modeflag <%= SECURE ? 'mode-sec' : 'mode-vuln' %>"><%= SECURE ? '🛡 MODO SEGURO' : '⚠ MODO VULNERABLE' %></span>
    <% if (user) { %>
      <a href="/orders">Pedidos</a>
      <a href="/profile">👤 <%= user.name %></a>
      <a href="/cart">🛒</a>
      <a href="/logout">Salir</a>
    <% } else { %>
      <a href="/cart">🛒</a>
      <a href="/login">Ingresar</a>
    <% } %>
  </nav>
</div></header>
<nav class="catbar"><div class="wrap">
  <% var _cats = ['Todos','Electronica','Accesorios','Hogar']; var _active = (typeof q !== 'undefined' ? q : ''); %>
  <% _cats.forEach(function(c){ var sel = (c==='Todos' && !_active) || (c.toLowerCase()===String(_active).toLowerCase()); %>
    <a class="<%= sel ? 'on' : '' %>" href="<%= c==='Todos' ? '/' : '/?q='+encodeURIComponent(c) %>"><%= c %></a>
  <% }); %>
</div></nav>
<main class="wrap">
