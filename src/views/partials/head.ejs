<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'VulnShop' %></title>
<style>
  :root{--bg:#f4f5f7;--surface:#fff;--surface2:#fafbfc;--border:#e3e6ea;--ink:#1b1f24;--muted:#6b7280;--brand:#2f6fed;--accent:#0f9d6a;--danger:#d64545;--danger-bg:#fdecec;--warn:#b4690e;--warn-bg:#fdf3e3}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.5}
  a{color:var(--brand);text-decoration:none}
  .wrap{max-width:1000px;margin:0 auto;padding:0 16px}
  .topbar{background:var(--surface);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:10}
  .topbar .wrap{display:flex;align-items:center;gap:14px;height:58px}
  .logo{font-weight:800;font-size:19px;display:flex;align-items:center;gap:8px}
  .logo .mark{width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,var(--brand),var(--accent));display:grid;place-items:center;color:#fff}
  .search{flex:1;max-width:360px;display:flex}
  .search input{flex:1;border:1px solid var(--border);border-radius:999px 0 0 999px;padding:8px 14px;font-size:14px;background:var(--surface2)}
  .search button{border:1px solid var(--border);border-left:none;border-radius:0 999px 999px 0;background:var(--surface);padding:0 14px;cursor:pointer}
  .nav{margin-left:auto;display:flex;align-items:center;gap:14px;font-size:14px}
  .modeflag{font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px}
  .mode-vuln{background:var(--danger-bg);color:var(--danger)}
  .mode-sec{background:color-mix(in srgb,var(--accent) 16%,transparent);color:var(--accent)}
  main{padding:22px 0 50px}
  h1{font-size:22px;margin:0 0 4px}
  .card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;box-shadow:0 1px 2px rgba(16,24,40,.05)}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:16px}
  .product{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden}
  .thumb{height:120px;display:grid;place-items:center;font-size:44px;background:var(--surface2);border-bottom:1px solid var(--border)}
  .product .info{padding:12px}
  .price{font-weight:800}
  .btn{border:none;border-radius:9px;padding:9px 14px;font-size:14px;font-weight:600;cursor:pointer;background:var(--brand);color:#fff;display:inline-block}
  .btn.accent{background:var(--accent)}
  .btn.ghost{background:transparent;color:var(--brand);border:1px solid var(--border)}
  .field{margin-bottom:12px}
  .field label{display:block;font-size:13px;font-weight:600;margin-bottom:5px}
  .field input,.field textarea,.field select{width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:9px;background:var(--surface2);font-size:14px;font-family:inherit}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--border)}
  .vuln{margin-top:16px;border:1px dashed var(--danger);background:var(--danger-bg);border-radius:10px;padding:12px 14px;font-size:13px}
  .vuln.safe{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,transparent)}
  .vuln code,pre code{font-family:ui-monospace,Menlo,Consolas,monospace}
  pre{background:#0d1117;color:#e6edf3;padding:12px;border-radius:8px;overflow:auto;font-size:12.5px}
  .error{background:var(--warn-bg);color:var(--warn);border-radius:8px;padding:10px;font-size:13px;margin:10px 0}
  .review{padding:11px 0;border-bottom:1px solid var(--border)}
  .pill{display:inline-block;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:600;background:var(--warn-bg);color:var(--warn)}
</style>
</head>
<body>
<header class="topbar"><div class="wrap">
  <a class="logo" href="/"><span class="mark">&#128722;</span> VulnShop</a>
  <form class="search" action="/" method="get"><input name="q" placeholder="Buscar productos..." value="<%= typeof q !== 'undefined' ? q : '' %>"><button>&#128269;</button></form>
  <nav class="nav">
    <span class="modeflag <%= SECURE ? 'mode-sec' : 'mode-vuln' %>"><%= SECURE ? 'MODO SEGURO' : 'MODO VULNERABLE' %></span>
    <% if (user) { %>
      <a href="/orders">Pedidos</a>
      <a href="/profile"><%= user.name %></a>
      <a href="/logout">Salir</a>
    <% } else { %>
      <a href="/login">Ingresar</a>
    <% } %>
  </nav>
</div></header>
<main class="wrap">
