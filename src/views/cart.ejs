<%- include('partials/head') %>
<h1>Tu carrito</h1>
<% if (cart.length === 0) { %>
  <div class="card" style="text-align:center;padding:40px">
    <div style="font-size:40px">🛒</div>
    <p style="font-weight:600;margin:10px 0 4px">Tu carrito está vacío</p>
    <p class="muted" style="margin:0 0 16px">Descubrí nuestros productos destacados.</p>
    <a class="btn" href="/">Ir al catálogo</a>
  </div>
<% } else { %>
  <div style="display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:start">
    <div class="card" style="padding:8px 20px">
      <% cart.forEach(function(i){ %>
        <div style="display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--border)">
          <div style="width:58px;height:58px;border-radius:10px;border:1px solid var(--border);overflow:hidden;background:var(--surface2);flex:none"><img src="/static/img/<%= i.id %>.svg" alt="" style="width:100%;height:100%;object-fit:cover"></div>
          <div style="flex:1">
            <div style="font-weight:600"><%= i.name %></div>
            <div class="muted" style="font-size:13px">Cantidad: <%= i.qty %> · $ <%= i.price.toLocaleString('es-AR') %> c/u</div>
          </div>
          <div class="price">$ <%= (i.price*i.qty).toLocaleString('es-AR') %></div>
        </div>
      <% }); %>
    </div>
    <div class="card">
      <h2 style="margin-top:0;font-size:16px">Resumen</h2>
      <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:8px"><span class="muted">Productos</span><span>$ <%= total.toLocaleString('es-AR') %></span></div>
      <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:12px"><span class="muted">Envío</span><span style="color:var(--accent-dark);font-weight:600">Gratis</span></div>
      <div style="display:flex;justify-content:space-between;font-weight:800;font-size:18px;border-top:1px solid var(--border);padding-top:12px"><span>Total</span><span>$ <%= total.toLocaleString('es-AR') %></span></div>
      <form method="post" action="/cart/checkout" style="margin-top:16px">
        <button class="btn accent" style="width:100%">Finalizar compra</button>
        <% if (!user) { %><p class="muted" style="font-size:12.5px;text-align:center;margin:10px 0 0">Necesitás <a href="/login">iniciar sesión</a> para comprar.</p><% } %>
      </form>
    </div>
  </div>
<% } %>
<%- include('partials/foot') %>
